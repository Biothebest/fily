{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allows the bundled main webview to invoke only Fily's typed Rust commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap",
    "allow-list-accounts",
    "allow-list-folders",
    "allow-start-sync",
    "allow-list-messages",
    "allow-get-message",
    "allow-search-messages",
    "allow-create-draft",
    "allow-list-plans",
    "allow-approve-plan",
    "allow-execute-plan",
    "allow-undo-action",
    "allow-list-audit",
    "allow-disconnect-account"
  ]
}
