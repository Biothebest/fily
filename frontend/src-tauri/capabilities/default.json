{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allows the bundled main webview to invoke only Fily's typed Rust commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-list-accounts",
    "allow-begin-account-connection",
    "allow-account-connection-status",
    "allow-complete-account-connection",
    "allow-list-folders",
    "allow-start-sync",
    "allow-list-messages",
    "allow-get-message",
    "allow-search-messages",
    "allow-create-draft",
    "allow-update-draft",
    "allow-list-drafts",
    "allow-delete-draft",
    "allow-create-reply-draft",
    "allow-create-send-preview",
    "allow-execute-send",
    "allow-list-plans",
    "allow-approve-plan",
    "allow-execute-plan",
    "allow-undo-action",
    "allow-list-audit",
    "allow-disconnect-account",
    "allow-legacy-migration-status",
    "allow-migrate-legacy"
  ]
}
