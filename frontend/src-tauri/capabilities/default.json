{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allows the bundled main webview to invoke only Fily's typed Rust commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-list-accounts",
    "allow-begin-account-connection",
    "allow-account-connection-status",
    "allow-complete-account-connection",
    "allow-list-folders",
    "allow-start-sync",
    "allow-list-messages",
    "allow-get-message",
    "allow-search-messages",
    "allow-discover-ollama-models",
    "allow-ask-records",
    "allow-create-draft",
    "allow-update-draft",
    "allow-list-drafts",
    "allow-delete-draft",
    "allow-create-reply-draft",
    "allow-create-send-preview",
    "allow-execute-send",
    "allow-list-plans",
    "allow-approve-plan",
    "allow-execute-plan",
    "allow-undo-action",
    "allow-list-audit",
    "allow-disconnect-account",
    "allow-legacy-migration-status",
    "allow-migrate-legacy",
    "allow-pick-folder-grant",
    "allow-list-folder-grants",
    "allow-revoke-folder-grant",
    "allow-rescan-folder-grant",
    "allow-get-file-record",
    "allow-search-files",
    "allow-list-file-relations",
    "allow-create-file-action-plan",
    "allow-approve-file-action-plan",
    "allow-execute-file-action-plan",
    "allow-undo-file-action",
    "allow-ask-agent",
    "allow-list-review-queue",
    "allow-decide-review-item",
    "allow-undo-review-item",
    "allow-list-rules",
    "allow-preview-rule-change",
    "allow-confirm-rule-change",
    "allow-list-archives",
    "allow-get-daily-report"
  ]
}
